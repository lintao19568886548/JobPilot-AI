# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=jobpilot
MYSQL_USERNAME=jobpilot
MYSQL_PASSWORD=replace_with_a_strong_local_password
MYSQL_ROOT_PASSWORD=replace_with_a_different_root_password

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Backend
SERVER_PORT=8088
SERVER_ADDRESS=127.0.0.1
JWT_SECRET=replace_with_at_least_32_random_characters
JWT_ACCESS_EXPIRATION=900
JWT_REFRESH_EXPIRATION=604800
FRONTEND_ORIGINS=http://localhost:5173
EXTENSION_ORIGIN_PATTERNS=chrome-extension://*

# Optional local bootstrap user. Never commit real credentials.
BOOTSTRAP_USER_ENABLED=true
BOOTSTRAP_USER_USERNAME=local_admin
BOOTSTRAP_USER_EMAIL=local_admin@example.local
BOOTSTRAP_USER_PASSWORD=replace_with_a_strong_local_password
BOOTSTRAP_USER_DISPLAY_NAME=Local User

# Frontend (Vite variables are compiled into browser code; never put secrets here.)
FRONTEND_API_BASE_URL=http://localhost:8088/api
VITE_API_BASE_URL=http://localhost:8088/api

# Phase 2 AI parser. Port 8010 avoids the unrelated local service using 8000.
AI_SERVICE_PORT=8010
AI_SERVICE_BASE_URL=http://127.0.0.1:8010
AI_SERVICE_INTERNAL_TOKEN=replace_with_a_random_service_to_service_token
JOB_PARSER_MODE=RULES_ONLY
# LLM mode remains disabled until all three values are intentionally configured.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_CIRCUIT_FAILURE_THRESHOLD=3
LLM_CIRCUIT_RESET_SECONDS=60
LLM_MAX_CONCURRENCY=2

# Phase 3 Matching Engine — real BGE-M3 + Milvus. Do not use random/fake vectors.
MILVUS_PORT=19531
MILVUS_URI=http://127.0.0.1:19531
MILVUS_COLLECTION=jobpilot_embeddings_bge_m3_v1
MINIO_ROOT_USER=replace_with_a_local_minio_user
MINIO_ROOT_PASSWORD=replace_with_a_strong_local_minio_password
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_VERSION=bge-m3-v1
EMBEDDING_DEVICE=cpu
EMBEDDING_MAX_CHARS=12000
HF_HOME=D:\JobPilot AI\runtime\huggingface
MATCHING_AI_READ_TIMEOUT_SECONDS=600
MATCHING_POLL_INTERVAL_MS=1000
MATCHING_MAX_ATTEMPTS=3
MATCHING_INITIAL_BACKOFF_SECONDS=2

# Phase 4 Recommendation Center, Dashboard and Global Search
RECOMMENDATION_BATCH_MAX_SIZE=100
RECOMMENDATION_BATCH_POLL_INTERVAL_MS=1000
ANALYTICS_TIMEZONE=Asia/Shanghai
DASHBOARD_CACHE_TTL_SECONDS=30
GLOBAL_SEARCH_MAX_RESULTS=20

# Phase 10 feedback learning and local-only safe automation.
LTR_MINIMUM_SAMPLE=30
# Scheduler is deliberately opt-in. Manual rule execution remains available when false.
AUTOMATION_CENTER_ENABLED=false
AUTOMATION_CENTER_POLL_INTERVAL_MS=60000

# Phase 7 browser extension and local-only Playwright Assist.
# Keep the worker disabled for normal use. Generate a fresh random token when intentionally testing Assist.
EXTENSION_PAIRING_EXPIRATION=300
EXTENSION_ACCESS_EXPIRATION=900
EXTENSION_REFRESH_EXPIRATION=604800
AUTOMATION_WORKER_ENABLED=false
AUTOMATION_WORKER_PORT=8020
AUTOMATION_WORKER_BASE_URL=http://127.0.0.1:8020
AUTOMATION_WORKER_TOKEN=replace_with_a_random_service_token_at_least_24_characters
AUTOMATION_TASK_EXPIRATION=300
AUTOMATION_ALLOWED_HOSTS=127.0.0.1,localhost
AUTOMATION_HEADLESS=true

# Phase 11 observability. OTLP export is deliberately disabled by default.
OTEL_EXPORTER_OTLP_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318/v1/traces
OTEL_TRACES_SAMPLER_PROBABILITY=0.10
OPERATIONS_METRICS_REFRESH_MS=30000

# Phase 12 local secure release. Gateway uses 8180 to avoid common 8080 conflicts.
JOBPILOT_GATEWAY_PORT=8180
BACKEND_PORT=8088
